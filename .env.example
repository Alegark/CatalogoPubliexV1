DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PORT=8080
# Solo si frontend y API se sirven desde dominios distintos.
# CORS_ORIGINS=https://tu-frontend.vercel.app
# Supabase Storage para banners en producción (solo en la API; nunca exponer la service role key al frontend).
# En desarrollo local puedes dejar estas variables comentadas: los banners se guardan en ./uploads/banners.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# SUPABASE_STORAGE_BUCKET=banners
# SUPABASE_PRODUCT_STORAGE_BUCKET=products
# Vercel Web Analytics (solo la API; nunca exponer el token en el frontend).
# VERCEL_ANALYTICS_TOKEN=tu-token-de-vercel
# VERCEL_PROJECT_ID=prj_tu-proyecto
# VERCEL_TEAM_ID=team_tu-equipo
